            "text": "{\"sessionId\":\"session-mcp-protocol\",\"title\":\"Session MCP inspection\",\"projectDirectory\":\"{{cwd}}\",\"status\":\"not_active_here\",\"capturedThroughSeq\":6,\"events\":[{\"type\":\"step/start\",\"data\":{\"turn\":1,\"step\":1},\"seq\":3,\"time\":1786406400003},{\"type\":\"assistant/message\",\"data\":{\"turn\":1,\"step\":1,\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Read the saved conversation without resuming its agent.\"}],\"source\":{\"kind\":\"model\",\"provider\":\"fixture\",\"model\":\"fixture\"},\"id\":\"{{message:2}}\"},\"usage\":{\"inputTokens\":4,\"outputTokens\":12},\"stream\":[]},\"surfaceOp\":\"append\",\"seq\":4,\"time\":1786406400004},{\"type\":\"step/end\",\"data\":{\"turn\":1,\"step\":1},\"seq\":5,\"time\":1786406400005},{\"type\":\"turn/end\",\"data\":{\"turn\":1,\"reason\":{\"kind\":\"completed\"}},\"seq\":6,\"time\":1786406400006}],\"nextAfterSeq\":6,\"hasMore\":false}"
